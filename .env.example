# Comma-separated key pool (at least 2). Ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Active Gemini model (gemini-2.0-flash was retired in 2026; use gemini-flash-latest or gemini-3.8-flash)
LLM_MODEL=gemini/gemini-flash-latest
# Local SQLite path (docker-compose overrides this to sqlite:////data/app.db)
DATABASE_URL=sqlite:///./app.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
CACHE_TYPE=local
CACHE_DIR=./llm_cache
KEY_COOLDOWN_SECONDS=30
LLM_MOCK=false
# Frontend build-time: public URL of the backend
VITE_API_URL=http://localhost:8000
